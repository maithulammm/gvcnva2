{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gvcnva2",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [{
    "binding": "GVCN_HISTORY",
    "database_name": "gvcn-history",
    "database_id": "2d31ce38-90c6-4b77-b4fe-893f3184fbbf",
    "migrations_dir": "cloudflare/migrations"
  }],
  "triggers": { "crons": ["0 18 * * *", "15 * * * *"] },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/api", "/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://mncplbuswsmjwcxsreas.supabase.co",
    "GVCN_D1_ARCHIVE_ENABLED": "true",
    "EVIDENCE_CLIENT_ID": "32d07852-5a8b-48c1-a8b4-a1141bd13725",
    "EVIDENCE_AUTH_MODE": "delegated",
    "MICROSOFT_TENANT_ID": "22215a7f-b9e3-4b53-bd27-3a317311e6ca",
    "MICROSOFT_CLIENT_ID": "94c476b3-4723-4161-9dea-d64ff8bf505c",
    "GVCN_ALLOWED_ORIGINS": "https://gvcnva2.lammt.workers.dev,https://maithulammm.github.io,https://va2gvcn.vercel.app",
    "GVCN_ADMIN_EMAIL": "lammt@vietanhschool.edu.vn"
  }
}
